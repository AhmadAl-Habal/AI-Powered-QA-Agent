# Application under test. Use a dedicated non-production environment.
BASE_URL=https://qa.example-app.company.com
LOGIN_URL=https://qa.example-app.company.com/login
TARGET_URL=https://qa.example-app.company.com/repositories

# Local Ollama service and models. Values are trimmed by src/config.js.
OLLAMA_BASE_URL=http://127.0.0.1:11434
NORMALIZER_MODEL=qwen2.5:7b-instruct
PLANNER_MODEL=qwen2.5-coder:7b
VISION_MODEL=qwen3-vl:8b

# Browser and safety settings.
HEADLESS=false
ALLOW_PROD=false
ASSERT_TIMEOUT_MS=60000
PAGE_GOTO_TIMEOUT_MS=60000
AUTH_SETUP_TIMEOUT_MS=180000

# Paths may be absolute or relative to this project root.
AUTH_STATE_PATH=playwright/.auth/user.json
ARTIFACTS_DIR=artifacts
RAW_TESTCASE_PATH=raw-testcases/inbox.txt
